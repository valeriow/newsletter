---
layout: none
permalink: /podcast.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:podcast="https://podcastindex.org/namespace/1.0">
  {%- assign pp = site.podcast_plataformas %}
  <channel>
    <title>Radar IA</title>
    <link>{{ '/podcast/' | absolute_url }}</link>
    <atom:link href="{{ '/podcast.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    <language>pt-BR</language>
    <description>As notícias de inteligência artificial — IA agêntica, open source, setor público e IA aplicada — numa conversa entre dois apresentadores. Episódio diário de ~20 minutos e balanço semanal de ~60 minutos aos domingos.{% if pp.spotify %} Ouça também no Spotify: {{ pp.spotify | xml_escape }}{% endif %}{% if pp.youtube_music %} · YouTube Music: {{ pp.youtube_music | xml_escape }}{% endif %}</description>
    <itunes:author>Radar IA</itunes:author>
    <itunes:owner><itunes:name>Valério Wittler</itunes:name><itunes:email>valeriow@gmail.com</itunes:email></itunes:owner>
    <itunes:image href="{{ '/assets/img/capa-podcast.png' | absolute_url }}"/>
    <image><url>{{ '/assets/img/capa-podcast.png' | absolute_url }}</url><title>Radar IA</title><link>{{ '/podcast/' | absolute_url }}</link></image>
    <itunes:category text="Technology"/>
    <itunes:category text="News"><itunes:category text="Tech News"/></itunes:category>
    <itunes:explicit>false</itunes:explicit>
    <itunes:type>episodic</itunes:type>
    {% if pp.spotify %}<podcast:id platform="spotify" id="{{ pp.spotify | split: '/show/' | last | split: '?' | first }}" url="{{ pp.spotify | xml_escape }}"/>{% endif %}
    {% if pp.youtube_music %}<podcast:id platform="youtube" url="{{ pp.youtube_music | xml_escape }}"/>{% endif %}
    {% assign eps = site.podcast | sort: "date" | reverse %}
    {% for e in eps %}{% assign id = e.semana | append: "-" | append: e.versao %}{% if e.episodio %}{% assign id = e.episodio %}{% endif %}{% assign a = site.data.audio[id] %}{% if a %}
    <item>
      <title>{{ e.title | xml_escape }}</title>
      <link>{% if e.edicao %}{{ e.edicao | absolute_url }}{% else %}{{ '/podcast/' | absolute_url }}{% endif %}</link>
      <guid isPermaLink="false">radar-ia-{{ id }}</guid>
      <pubDate>{{ a.publicado | default: e.date | date_to_rfc822 }}</pubDate>
      <description>{{ e.resumo | default: e.title | xml_escape }} Edição escrita, fontes e links: {% if e.edicao %}{{ e.edicao | absolute_url }}{% else %}{{ '/podcast/' | absolute_url }}{% endif %}{% if pp.spotify %} · Spotify: {{ pp.spotify | xml_escape }}{% endif %}{% if pp.youtube_music %} · YouTube Music: {{ pp.youtube_music | xml_escape }}{% endif %}</description>
      <enclosure url="{{ a.url }}" length="{{ a.bytes }}" type="audio/mpeg"/>
      <itunes:duration>{{ a.duracao_seg }}</itunes:duration>
      <itunes:episodeType>full</itunes:episodeType>
      <itunes:explicit>false</itunes:explicit>
      <itunes:author>Radar IA</itunes:author>
      <itunes:summary>{{ e.resumo | default: e.title | xml_escape }}</itunes:summary>
    </item>
    {% endif %}{% endfor %}
  </channel>
</rss>
